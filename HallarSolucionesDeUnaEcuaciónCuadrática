#include <iostream>
#include <cmath>
using namespace std;
int main()
{
    float a,b,c,x1,x2,i;
    cout << "===Hallar solucion de un polinomio de grado 2 de la forma ax^2+bx+c=0===" << endl;
    cout << "Introduzca el coeficiente de a: "; 
    cin >> a;
    cout << "Introduzca el coeficiente de b: ";
    cin >> b;
    cout << "Introduzca el coeficiente de c: ";
    cin >> c;
    if (a==0){
        cout << "Este no es un polinomio de grado 2, pero la solución es: "<< -c/b;
    }
    else {
        if (b*b-4*a*c>0) {
            x1 = ((-1)*b+sqrt(b*b-4*a*c))/(2*a);
            x2 = ((-1)*b-sqrt(b*b-4*a*c))/(2*a);
            cout << "La ecuación tiene dos soluciones, las cuales son: " << x1 << " y " << x2 ; 
        }
        else 
        {
            if (b*b-4*a*c==0)
            {
                cout << "La ecuación tiene una única solución, la cuál es: " << -b/(2*a) ; 
            }
            else 
            {
                x1 = -b/(2*a);
                i = (sqrt(-(b*b-4*a*c)))/(2*a);
                cout << "La ecuación tiene dos soluciones complejas, las cuales son: " << x1 <<"+"<< i << "i, y " << x1 << "-" << i << "i";
            }
        }
    } 
    return 0;
}
