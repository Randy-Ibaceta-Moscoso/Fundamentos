#include <iostream>
using namespace std;

int main()
{
    
    int opcion, cantidad;
    
    cout << "CALCULAR COMPRA" << endl;
    
    cout << "   1. Hamburguesa:    3bs" << endl;
    cout << "   2. Hamburguesa con queso:  5bs" << endl;
    cout << "   3. Papas Fritas:   2bs" << endl;
    cout << "   4. Soda:   2,5bs" << endl;
    cout << "   0. Salir de la compra." << endl;
    
    cout << "¿Qué desea ordenar?, seleccione una de las opciones de acuerdo al numero de la lista." << endl;
    cin >> opcion;
    
    if (opcion==0)
        return 0;
    
    cout << "¿Cuantas unidades desea?" << endl;
    cin >> cantidad;
    
    switch (opcion){
        case 1:
            cout << "El total de su compra es:  " << 3*cantidad;
            break;
        case 2:
            cout << "El total de su compra es:  " << 5*cantidad;
            break;
        case 3:
            cout << "El total de su compra es:  " << 2*cantidad;
            break;
        case 4:
            cout << "El total de su compra es:  " << 2.5*cantidad;
            break;
        default:
            cout << "Error, nada coincide con el menu.";
    }
    return 0;
}
