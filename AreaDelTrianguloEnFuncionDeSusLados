#include <iostream>
#include <cmath>
using namespace std;
int main()
{
    float a,b,c,s,area;
    cout<<"Ingrese el primer lado de su triángulo: ";
    cin>>a;
    cout<<"Ingrese el segundo lado de su triángulo: ";
