//

#include <iostream>
#include <cmath>
using namespace std;
int main()
{
    int n, i, cont = 2, caux = 1, r;
    bool flag=true;
    
    do {



        cout << "Ingrese la cantidad de primos que quiere generar:";
        cin >> n;

        while (caux <= n) {
            flag = true;
            for (i = 2; i <= sqrt(cont); i++)
                if (cont % i == 0) {
                    flag = false;
                    break;
                }
            if (flag == true) {
                cout << cont << endl;
                caux++;
            }
            cont++;
        }
        cout << "Quiere reiniciar el programa? (SI = 1, NO = 0)" << endl;
        cin >> r;

        if (r == 1) {
            cout << "Reiniciando." << endl;
        }

        if (r == 0) {
            cout << "Saliendo del programa." << endl;
            return 0;
        }

        if (r != 1 && r != 0) {
            cout << "Respuesta no valida.";
            return 0;
        }

        cont = 2;
        caux = 1;
    } while (r == 1);
    return 0;
}
